    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <!-- Test project lives inside the repository, but builds separately. -->
  <ItemGroup>
    <Compile Remove="tests/RestaurantMvc.Tests/**" />
    <Content Remove="tests/RestaurantMvc.Tests/**" />
    <None Remove="tests/RestaurantMvc.Tests/**" />
    <EmbeddedResource Remove="tests/RestaurantMvc.Tests/**" />
  </ItemGroup>
</Project>
