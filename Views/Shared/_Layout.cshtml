<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#151411">
  <meta name="description" content="Bếp Nhà – Đặt bàn, gọi món và theo dõi bữa ăn của bạn.">
  <title>@ViewData["Title"] · Bếp Nhà</title>
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/styles.css" asp-append-version="true">
  <link rel="stylesheet" href="~/lib/animate-css/animate.min.css" asp-append-version="true">
  <link rel="stylesheet" href="~/feast.css" asp-append-version="true">
  <link rel="stylesheet" href="~/restaurant-motion.css" asp-append-version="true">
  <script src="~/app.js" asp-append-version="true" type="module"></script>
  <script src="~/banner-motion.js" asp-append-version="true" type="module"></script>
  <script src="~/restaurant-motion.js" asp-append-version="true" type="module"></script>
</head>
<body>
  <partial name="_Header" />
  @RenderBody()
  <partial name="_Footer" />
  <dialog id="dialog" aria-labelledby="dialog-title"></dialog>
  <div id="toast" role="status" aria-live="polite"></div>
  <button class="back-to-top" id="back-to-top" type="button" data-action="back-to-top" aria-label="Về đầu trang">↑</button>
  <div class="support-widget" id="support-widget">
    <div class="support-menu" id="support-menu" hidden>
      <div class="support-menu-heading">
        <strong>Chăm sóc khách hàng</strong>
        <span>Bếp Nhà luôn sẵn sàng hỗ trợ bạn</span>
      </div>
      <button class="support-option support-option-chat" type="button" data-action="support-chat">
        <span class="support-option-icon">💬</span>
        <span><strong>Nhắn trực tiếp</strong><small>Để lại lời nhắn cho Bếp Nhà</small></span>
      </button>
      <a class="support-option" href="https://zalo.me/0868749948" target="_blank" rel="noopener noreferrer">
        <span class="support-option-icon support-option-zalo">Z</span>
        <span><strong>Nhắn qua Zalo</strong><small>0868 749 948</small></span>
        <span class="support-option-arrow">↗</span>
      </a>
      <a class="support-option" href="https://www.facebook.com/nhatle.1907.2006" target="_blank" rel="noopener noreferrer">
        <span class="support-option-icon support-option-facebook">f</span>
        <span><strong>Nhắn qua Fanpage</strong><small>Facebook Bếp Nhà</small></span>
        <span class="support-option-arrow">↗</span>
      </a>
    </div>
    <button class="support-toggle" type="button" data-action="support-toggle" aria-expanded="false" aria-controls="support-menu" aria-label="Mở chăm sóc khách hàng">
      <span class="support-toggle-icon">💬</span><span>Hỗ trợ</span>
    </button>
  </div>
</body>
</html>
